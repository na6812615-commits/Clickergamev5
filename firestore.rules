rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNonNegativeInt(val) {
      return val is int && val >= 0;
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'userId', 'displayName', 'clicks', 'lifetimePoints',
          'bestCombo', 'restartLv', 'reactorCode', 'hasVipPass',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'displayName', 'clicks', 'lifetimePoints',
          'bestCombo', 'restartLv', 'reactorCode', 'hasVipPass',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && isBoundedString(data.displayName, 1, 40)
        && isNonNegativeInt(data.clicks)
        && isNonNegativeInt(data.lifetimePoints)
        && isNonNegativeInt(data.bestCombo)
        && isNonNegativeInt(data.restartLv)
        && isBoundedString(data.reactorCode, 1, 12)
        && data.hasVipPass is bool
        && data.createdAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    // --- Global Leaderboard ---
    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn()
        && (request.query.limit == null || (request.query.limit >= 1 && request.query.limit <= 100));

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && isValidLeaderboardEntry(incoming());

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == existing().userId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'clicks', 'lifetimePoints',
          'bestCombo', 'restartLv', 'reactorCode',
          'hasVipPass', 'updatedAt'
        ])
        && isValidLeaderboardEntry(incoming());

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
